# Database (local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mithaq
DB_USER=postgres
DB_PASS=yourpassword
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Gemini (Google AI Studio — free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# File uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# App
PORT=5000
NODE_ENV=development
# CLIENT_URL: comma-separated list of allowed CORS origins (admin SPA, expo dev, expo web).
# Leave unset to reflect any request origin (dev convenience; credentials still allowed).
CLIENT_URL=http://localhost:8080,http://localhost:8081,http://localhost:19006

# Optional one-time admin seed. Disable after the first successful boot.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=admin@mithaq.local
ADMIN_PASSWORD=replace_with_a_unique_16_character_password

# Setup notes:
# 1. Install pgvector: sudo apt install postgresql-16-pgvector
# 2. In psql: CREATE EXTENSION IF NOT EXISTS vector;
# 3. Copy this file to .env and fill values
